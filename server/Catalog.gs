/* WORKNIC public catalog + OS administrator editing. No prices or customer data. */
var WC_CATALOG_SHEET='OS_브랜드상품';
var WC_CATALOG_AUDIT='OS_브랜드상품이력';
function wcCatalogSheet_(){var ss=ss_(),s=ss.getSheetByName(WC_CATALOG_SHEET);if(!s){s=ss.insertSheet(WC_CATALOG_SHEET);s.appendRow(['key','kind','id','recordJSON','revision','updatedAt','updatedBy']);s.setFrozenRows(1)}return s}
function wcCatalogAudit_(){var ss=ss_(),s=ss.getSheetByName(WC_CATALOG_AUDIT);if(!s){s=ss.insertSheet(WC_CATALOG_AUDIT);s.appendRow(['at','actor','action','key','revision','phase']);s.setFrozenRows(1)}return s}
function wcCatalogRows_(){var s=wcCatalogSheet_();return s.getLastRow()<2?[]:s.getRange(2,1,s.getLastRow()-1,7).getValues().filter(function(r){return r[0]}).map(function(r,i){return{key:String(r[0]),kind:String(r[1]),id:String(r[2]),record:JSON.parse(r[3]),revision:Number(r[4]),row:i+2}})}
function wcCatalogText_(v,n){return String(v==null?'':v).trim().slice(0,n)}
function wcCatalogImage_(v){var raw=String(v||'').trim();if(/^data:image\/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+$/.test(raw)){if(raw.length>36000)throw Error('로고 파일 크기를 줄여주세요.');return raw}var s=wcCatalogText_(v,1600);if(!s)return '';if(/^\/assets\/[a-zA-Z0-9_./-]+$/.test(s)&&s.indexOf('..')<0)return s;if(/^https:\/\//.test(s)){var m=s.match(/^https:\/\/([^/?#]+)/);if(m&&m[1].indexOf('@')<0&&!/^(localhost|127\.|10\.|192\.168\.|169\.254\.)/i.test(m[1]))return s}throw Error('이미지는 안전한 HTTPS 주소 또는 사이트 assets 경로를 입력해 주세요.')}
function wcCatalogValidate_(kind,p,all){p=p||{};var id=wcCatalogText_(p.id,80);if(!/^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$/.test(id))throw Error('ID는 영문·숫자·하이픈·밑줄로 입력해 주세요.');var out={id:id,name:wcCatalogText_(p.name,160),published:p.published===true,order:Math.max(0,Math.min(100000,Number(p.order)||0))};if(!out.name)throw Error('이름이 필요합니다.');if(kind==='brand'){out.english=wcCatalogText_(p.english,80);out.category=wcCatalogText_(p.category,80);out.logo=wcCatalogImage_(p.logo);out.logoSource=wcCatalogText_(p.logoSource,1600);out.aliases=(Array.isArray(p.aliases)?p.aliases:[]).slice(0,20).map(function(x){return wcCatalogText_(x,80)}).filter(String)}else{out.brand=wcCatalogText_(p.brand,80);if(!all.some(function(r){return r.kind==='brand'&&r.id===out.brand}))throw Error('먼저 해당 브랜드를 등록해 주세요.');out.model=wcCatalogText_(p.model,160);out.summary=wcCatalogText_(p.summary,600);out.category=wcCatalogText_(p.category,80);out.specs=(Array.isArray(p.specs)?p.specs:[]).slice(0,20).map(function(x){return[wcCatalogText_(x[0],80),wcCatalogText_(x[1],600)]}).filter(function(x){return x[0]&&x[1]});out.images=(Array.isArray(p.images)?p.images:[]).slice(0,3).map(wcCatalogImage_).filter(String);if(out.published&&!out.images.length)throw Error('공개 상품에는 사진이 1장 이상 필요합니다.');out.sourceUrl=wcCatalogText_(p.sourceUrl,1000);if(out.sourceUrl&&!/^https:\/\/smartstore\.naver\.com\/[a-zA-Z0-9_-]+\/products\/\d+$/.test(out.sourceUrl))throw Error('상품 출처는 네이버 스마트스토어 상품 주소를 입력해 주세요.');out.sourceTitle=wcCatalogText_(p.sourceTitle,300);out.sourceCheckedOn=wcCatalogText_(p.sourceCheckedOn,20)}return wcCatalogPreserve_(kind,out,all)}
function wcCatalogPreserve_(kind,out,all){if(kind!=='product')return out;var old=all.find(function(r){return r.kind==='product'&&r.id===out.id}),record=old&&old.record;if(record){['guide','collections','manufacturerPartNumber','variants','sourceImport'].forEach(function(key){if(record[key]!==undefined)out[key]=JSON.parse(JSON.stringify(record[key]))});if(record.guide&&(record.brand!==out.brand||record.model!==out.model))throw Error('상세자료가 연결된 상품의 브랜드·모델 변경은 검토 후 원본에서 진행해 주세요.');}if(out.published&&(!record||record.published!==true)&&(!out.guide||!out.guide.quality||out.guide.quality.state!=='reviewed'))throw Error('사진·규격·판매 구성 검토가 완료된 상품만 새로 공개할 수 있습니다.');return out;}
function wcCatalogView_(all,admin){var brands=all.filter(function(r){return r.kind==='brand'&&(admin||r.record.published===true)}).map(function(r){return Object.assign({},r.record,{revision:r.revision})}).sort(function(a,b){return a.order-b.order||a.name.localeCompare(b.name)}),ids=brands.map(function(b){return b.id});return{schemaVersion:1,capabilities:{preservesProductMetadata:true,requiresReviewedPublication:true},updatedAt:new Date().toISOString(),brands:brands,products:all.filter(function(r){return r.kind==='product'&&(admin||(r.record.published===true&&ids.indexOf(r.record.brand)>=0))}).map(function(r){return Object.assign({},r.record,{revision:r.revision})}).sort(function(a,b){return a.order-b.order||a.name.localeCompare(b.name)})}}
function wcCatalogSave_(kind,p,actor){var lock=LockService.getScriptLock();if(!lock.tryLock(15000))throw Error('다른 저장 작업이 진행 중입니다. 잠시 후 다시 시도해 주세요.');try{var all=wcCatalogRows_(),out=wcCatalogValidate_(kind,p,all),key=kind+':'+out.id,old=all.find(function(r){return r.key===key}),expected=Number(p.revision)||0;if(old&&expected!==old.revision)throw Error('다른 곳에서 수정된 항목입니다. 목록을 다시 불러와 주세요.');if(!old&&expected!==0)throw Error('새 항목 정보를 다시 확인해 주세요.');var rev=old?old.revision+1:1,at=new Date().toISOString(),audit=wcCatalogAudit_();audit.appendRow([at,actor,'save',key,rev,'prepared']);var cells=[key,kind,out.id,JSON.stringify(out),rev,at,actor];if(old)wcCatalogSheet_().getRange(old.row,1,1,7).setValues([cells]);else wcCatalogSheet_().appendRow(cells);SpreadsheetApp.flush();audit.appendRow([at,actor,'save',key,rev,'committed']);CacheService.getScriptCache().remove('WORKNIC_PUBLIC_CATALOG');return Object.assign({},out,{revision:rev})}finally{lock.releaseLock()}}
function worknicCatalogRoute_(q){try{var a=q.action,p=q.payload||{};if(a==='catalog.get'){var cache=CacheService.getScriptCache(),saved=cache.get('WORKNIC_PUBLIC_CATALOG');if(saved)return{ok:true,data:JSON.parse(saved)};var data=wcCatalogView_(wcCatalogRows_(),false),encoded=JSON.stringify(data);if(encoded.length<80000)cache.put('WORKNIC_PUBLIC_CATALOG',encoded,60);return{ok:true,data:data}}var actor;try{actor=admin_(q.token)}catch(authError){return{ok:false,code:'UNAUTHORIZED',error:'워크닉 OS 관리자 계정으로 로그인해 주세요.'}}if(a==='catalog.admin')return{ok:true,data:wcCatalogView_(wcCatalogRows_(),true)};if(a==='catalog.saveBrand')return{ok:true,data:wcCatalogSave_('brand',p,actor)};if(a==='catalog.saveProduct')return{ok:true,data:wcCatalogSave_('product',p,actor)};if(a==='catalog.import'){var batch=Array.isArray(p.products)?p.products:[];if(batch.length>60)throw Error('한 번에 60개 이하로 가져와 주세요.');var existing=wcCatalogRows_(),all=existing,seen={},add=[];batch.forEach(function(item){item=Object.assign({},item,{published:false,revision:0});if(existing.some(function(r){return r.key==='product:'+item.id})||seen[item.id])return;var validated=wcCatalogValidate_('product',item,all);seen[item.id]=true;add.push(validated)});var lock=LockService.getScriptLock();if(!lock.tryLock(15000))throw Error('다른 저장 작업이 진행 중입니다.');try{existing=wcCatalogRows_();add=add.filter(function(x){return !existing.some(function(r){return r.key==='product:'+x.id})});if(add.length){var sheet=wcCatalogSheet_(),at=new Date().toISOString();wcCatalogAudit_().appendRow([at,actor,'import',String(add.length),1,'prepared']);sheet.getRange(sheet.getLastRow()+1,1,add.length,7).setValues(add.map(function(x){return['product:'+x.id,'product',x.id,JSON.stringify(x),1,at,actor]}));SpreadsheetApp.flush();wcCatalogAudit_().appendRow([at,actor,'import',String(add.length),1,'committed'])}return{ok:true,data:{added:add.length,skipped:batch.length-add.length}}}finally{lock.releaseLock()}}throw Error('지원하지 않는 카탈로그 요청입니다.')}catch(e){return{ok:false,error:e.message||String(e)}}}
function initializeWorknicCatalog(){var sheet=wcCatalogSheet_();wcCatalogAudit_();if(sheet.getLastRow()>1){Logger.log(JSON.stringify({ok:true,alreadyInitialized:true,rows:sheet.getLastRow()-1}));return}var response=UrlFetchApp.fetch('https://worknic.co.kr/data/catalog.json',{muteHttpExceptions:true});if(response.getResponseCode()!==200)throw Error('공개 초기 카탈로그 파일을 확인해 주세요.');var data=JSON.parse(response.getContentText()),records=[];data.brands.forEach(function(b){records.push({kind:'brand',id:b.id,record:b})});data.products.forEach(function(p){records.push({kind:'product',id:p.id,record:p})});var at=new Date().toISOString(),cells=records.map(function(r){var out=wcCatalogValidate_(r.kind,r.record,records);return[r.kind+':'+r.id,r.kind,r.id,JSON.stringify(out),1,at,'SYSTEM_INIT']});sheet.getRange(2,1,cells.length,7).setValues(cells);wcCatalogAudit_().appendRow([at,'SYSTEM_INIT','initialize',String(cells.length),1,'committed']);Logger.log(JSON.stringify({ok:true,brands:data.brands.length,products:data.products.length}))}
