/* Product-code content workspace. No catalog, price, stock, order or customer writes. */
var WPC_SHEET='OS_상품콘텐츠이력';
function wpcText_(v,n){if(typeof v!=='string'||v.length>n)throw Error('텍스트 형식 또는 길이를 확인해 주세요.');return v.trim()}
function wpcCode_(v){if(typeof v!=='string'||! /^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$/.test(v))throw Error('상품코드를 확인해 주세요.');return v}
function wpcURL_(v){var s=wpcText_(v,1600);if(!s)return '';if(/^\/assets\/[A-Za-z0-9_./-]+$/.test(s)&&s.indexOf('..')<0)return s;var m=s.match(/^https:\/\/([a-z0-9.-]+)(?::443)?(?:[/?#]|$)/i);if(!m||/[\s\\\u0000-\u001f]/.test(s)||/^(localhost|127\.|0\.|10\.|192\.168\.|169\.254\.|172\.(1[6-9]|2\d|3[01])\.)/i.test(m[1])||m[1].indexOf('.')<0)throw Error('공개 HTTPS 주소 또는 assets 경로를 사용해 주세요.');return s}
function wpcRecord_(p){if(!p||typeof p!=='object'||Array.isArray(p))throw Error('콘텐츠를 확인해 주세요.');var allowed=['thumbnail','description','specs','sources','checkedOn'];Object.keys(p).forEach(function(k){if(allowed.indexOf(k)<0)throw Error('수정할 수 없는 필드: '+k)});var out={};
 if(p.thumbnail){if(Object.keys(p.thumbnail).some(function(k){return ['url','alt'].indexOf(k)<0}))throw Error('썸네일 필드를 확인해 주세요.');out.thumbnail={url:wpcURL_(p.thumbnail.url),alt:wpcText_(p.thumbnail.alt,240)};if(!out.thumbnail.url||!out.thumbnail.alt)throw Error('사진 주소와 대체텍스트가 필요합니다.')}
 if(p.description!==undefined)out.description=wpcText_(p.description,8000);
 if(p.specs!==undefined){if(!Array.isArray(p.specs)||p.specs.length>80)throw Error('규격은 최대 80개입니다.');out.specs=p.specs.map(function(x){if(!Array.isArray(x)||x.length!==2)throw Error('규격 항목명과 값을 입력해 주세요.');var row=[wpcText_(x[0],160),wpcText_(x[1],500)];if(!row[0]||!row[1])throw Error('빈 규격은 저장할 수 없습니다.');return row})}
 if(!Array.isArray(p.sources)||p.sources.length>20)throw Error('출처 목록을 확인해 주세요.');out.sources=p.sources.map(function(x){if(!x||Object.keys(x).some(function(k){return ['url','label'].indexOf(k)<0}))throw Error('출처 필드를 확인해 주세요.');return {url:wpcURL_(x.url),label:wpcText_(x.label,240)}});if(out.sources.some(function(x){return !x.url||!x.label}))throw Error('출처 주소와 설명을 입력해 주세요.');out.checkedOn=wpcText_(p.checkedOn||'',10);if(out.checkedOn&&(!/^\d{4}-\d{2}-\d{2}$/.test(out.checkedOn)||isNaN(Date.parse(out.checkedOn+'T00:00:00Z'))||new Date(out.checkedOn+'T00:00:00Z').toISOString().slice(0,10)!==out.checkedOn))throw Error('실제 확인일을 YYYY-MM-DD로 입력해 주세요.');if(JSON.stringify(out).length>30000)throw Error('콘텐츠가 너무 깁니다.');return out}
function wpcSheet_(create){var s=ss_().getSheetByName(WPC_SHEET);if(!s&&create){s=ss_().insertSheet(WPC_SHEET);s.appendRow(['at','actor','action','code','revision','stateJSON']);s.setFrozenRows(1)}return s}
function wpcEvents_(){var s=wpcSheet_(false);return !s||s.getLastRow()<2?[]:s.getRange(2,1,s.getLastRow()-1,6).getValues().map(function(v){return {at:String(v[0]),actor:String(v[1]),action:String(v[2]),code:String(v[3]),revision:Number(v[4]),state:JSON.parse(v[5])}})}
function wpcState_(code,events){var found=events.filter(function(e){return e.code===code}).pop();return found?found.state:{code:code,revision:0,draft:null,published:null}}
function wpcClone_(v){return JSON.parse(JSON.stringify(v))}
function wpcKnownCode_(code){var cache=CacheService.getScriptCache(),key='WPC_KNOWN_'+code;if(cache.get(key)==='1')return;var r=UrlFetchApp.fetch('https://worknic.co.kr/data/assortment.json',{muteHttpExceptions:true});if(r.getResponseCode()!==200)throw Error('원본 품목 목록을 확인할 수 없습니다. 잠시 후 다시 시도해 주세요.');var d=JSON.parse(r.getContentText());if(d.schema!==1||!Array.isArray(d.products)||!d.products.some(function(p){return p.code===code}))throw Error('원본 품목 목록에 없는 상품코드입니다.');cache.put(key,'1',300)}
function wpcAppend_(s,actor,action){if(s.revision>0x7ffffffe)throw Error('수정 번호를 확인해 주세요.');s.revision++;s.updatedAt=new Date().toISOString();var json=JSON.stringify(s);if(json.length>45000)throw Error('콘텐츠가 너무 깁니다.');wpcSheet_(true).appendRow([s.updatedAt,String(actor),action,s.code,s.revision,json]);return wpcClone_(s)}
function worknicProductContentRoute_(q){try{var a=q.action,p=q.payload||{},allowed=['catalog.content.get','catalog.content.read','catalog.content.saveDraft','catalog.content.review','catalog.content.publish','catalog.content.unpublish','catalog.content.history','catalog.content.restoreDraft'];if(allowed.indexOf(a)<0)throw Error('지원하지 않는 콘텐츠 요청입니다.');
 if(a==='catalog.content.get'){if(!Array.isArray(p.codes)||p.codes.length>120)throw Error('상품코드는 최대 120개입니다.');var codes=p.codes.map(wpcCode_),events=wpcEvents_(),items={};codes.forEach(function(code){var s=wpcState_(code,events);if(s.published)items[code]={code:code,revision:s.published.revision,record:s.published.record,publishedAt:s.published.at}});return {ok:true,data:{schema:1,items:items}}}
 var actor;try{actor=admin_(q.token)}catch(e){return {ok:false,code:'UNAUTHORIZED',error:'OS 관리자 로그인이 필요합니다.'}}var code=wpcCode_(p.code);
 if(a==='catalog.content.read'){return {ok:true,data:wpcState_(code,wpcEvents_())}}
 if(a==='catalog.content.history'){return {ok:true,data:{items:wpcEvents_().filter(function(e){return e.code===code}).slice(-50).reverse().map(function(e){return {at:e.at,actor:e.actor,action:e.action,revision:e.revision}})}}}
 var lock=LockService.getScriptLock();if(!lock.tryLock(15000))throw Error('다른 저장 작업이 진행 중입니다.');try{var events=wpcEvents_(),s=wpcClone_(wpcState_(code,events));if(!Number.isInteger(p.revision)||p.revision!==s.revision)return {ok:false,code:'CONFLICT',error:'다른 창에서 수정되었습니다. 새로 불러온 뒤 비교해 주세요.'};
 if(a==='catalog.content.saveDraft'){wpcKnownCode_(code);s.draft={record:wpcRecord_(p.record),status:'draft',review:null};}
 else if(a==='catalog.content.restoreDraft'){var event=events.find(function(e){return e.code===code&&e.revision===p.historyRevision});if(!event)throw Error('복구할 이력이 없습니다.');var old=event.state.draft||event.state.published;if(!old)throw Error('이력에 콘텐츠가 없습니다.');s.draft={record:wpcRecord_(old.record),status:'draft',review:null};}
 else if(a==='catalog.content.review'){if(!s.draft)throw Error('먼저 초안을 저장해 주세요.');var checks=p.checks||{},r=s.draft.record;if(!['identity','photos','specs','sources'].every(function(k){return checks[k]===true})||!r.sources.length||!r.checkedOn)throw Error('상품코드·사진·규격·출처 검수와 확인일이 필요합니다.');s.draft.status='reviewed';s.draft.review={actor:String(actor),at:new Date().toISOString(),revision:s.revision+1};}
 else if(a==='catalog.content.publish'){if(!s.draft||s.draft.status!=='reviewed'||s.draft.review.revision!==s.revision)throw Error('최신 초안을 검수한 뒤 발행해 주세요.');s.published={record:wpcClone_(s.draft.record),revision:s.revision+1,at:new Date().toISOString()};s.draft=null;}
 else if(a==='catalog.content.unpublish'){if(!s.published)throw Error('발행된 콘텐츠가 없습니다.');s.published=null;}
 return {ok:true,data:wpcAppend_(s,actor,a)};}finally{lock.releaseLock()}
 }catch(e){return {ok:false,error:e.message||String(e)}}}
